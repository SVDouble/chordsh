{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!!local", "!!dist", "!package-lock.json", "!benchmarks/history.jsonl"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "single", "trailingCommas": "all" } },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": { "enabled": true, "indentScriptAndStyle": true }
  },
  "markdown": { "formatter": { "enabled": true, "proseWrap": "preserve" } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": { "noNonNullAssertion": "off", "noDescendingSpecificity": "off", "useTemplate": "off" },
      "suspicious": { "useIterableCallbackReturn": "off" }
    }
  },
  "assist": { "enabled": false }
}
