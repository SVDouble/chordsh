{
  "name": "musify",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "replay": "REPLAY=1 vitest run --silent=false",
    "fetch-data": "python3 -I scripts/fetch_datasets.py",
    "benchmark": "EVAL=scripts/benchmark.test.ts vitest run --silent=false",
    "tune": "EVAL=scripts/tune.test.ts vitest run --silent=false",
    "lint": "biome lint . --error-on-warnings && markdownlint-cli2 \"**/*.md\"",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "train": "EVAL=scripts/train.test.ts vitest run --silent=false && biome format --write src/engine/transitions.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "markdownlint-cli2": "^0.24.1",
    "svelte": "^5.58.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "paneforge": "^1.0.2"
  }
}
